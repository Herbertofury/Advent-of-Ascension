#!/usr/bin/env python3
"""Finalize and verify the complete live AoA weapon inspiration Wiki."""
from pathlib import Path
import hashlib,importlib.machinery,importlib.util,json,shutil,sys,time
ROOT=Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT))
loader=importlib.machinery.SourceFileLoader('final_delta',str(ROOT/'final_delta.py.delta'))
spec=importlib.util.spec_from_loader(loader.name,loader);d=importlib.util.module_from_spec(spec);loader.exec_module(d)
g=d.g;p=d.p;f=d.f
ORIGINAL_RENDER=p.render

def render(entries,media,title,other):
 body=ORIGINAL_RENDER(entries,media,title,other)
 for e in entries:
  im=media[e['id']].get('image')
  if im:
   url=g.RAW+Path(im['local']).name
   body=body.replace(url+'"',url+'?v='+im['sha256'][:7]+'"')
 assert len(body.encode('utf-8'))<490000,(title,len(body.encode('utf-8')))
 return body
p.render=render

def native_check():
 from playwright.sync_api import sync_playwright
 c=g.load(ROOT/'catalog.json',{});qa=ROOT/'qa';qa.mkdir(exist_ok=True)
 reports=[]
 with sync_playwright() as pw:
  executable=shutil.which('google-chrome') or shutil.which('chromium') or shutil.which('chromium-browser')
  options={'headless':True,'args':['--no-sandbox','--disable-dev-shm-usage']}
  if executable:options['executable_path']=executable
  browser=pw.chromium.launch(**options)
  page=browser.new_page(viewport={'width':1440,'height':1100},device_scale_factor=1)
  for key,slug in zip(('gaming','historical'),g.PAGES):
   url=g.WIKI+slug
   page.goto(url,wait_until='domcontentloaded',timeout=90000)
   page.locator('#wiki-body').wait_for(timeout=30000)
   page.evaluate('''() => {document.querySelectorAll('#wiki-body img').forEach(im => { im.loading='eager'; });}''')
   page.wait_for_function('''() => { const a=[...document.querySelectorAll('#wiki-body img')].filter(im => (im.getAttribute('data-canonical-src')||im.src).includes('weapon-inspirations/images/')); return a.length>0 && a.every(im=>im.complete); }''',timeout=180000)
   data=page.evaluate('''() => {const a=[...document.querySelectorAll('#wiki-body img')].filter(im => (im.getAttribute('data-canonical-src')||im.src).includes('weapon-inspirations/images/'));return {count:a.length,broken:a.filter(im=>im.naturalWidth===0).map(im=>({alt:im.alt,src:im.src})),loaded:a.filter(im=>im.naturalWidth>0).length,text:document.querySelector('#wiki-body').innerText};}''')
   expected=len(c[key]);missing=[e['name'] for e in c[key] if e['name'] not in data['text']]
   report={'page':slug,'url':url,'expected_entries':expected,'rendered_images':data['count'],'decoded_images':data['loaded'],'broken_images':data['broken'],'missing_entries':missing,'end_marker_visible':'End of gallery' in data['text']}
   page.locator('#wiki-body').scroll_into_view_if_needed();page.screenshot(path=str(qa/(key+'-browser-top.png')))
   if key=='gaming':
    for anchor in ('collection-ratchet-clank-rift-apart','collection-warframe'):
     loc=page.locator('#user-content-'+anchor)
     if not loc.count():loc=page.locator('#'+anchor)
     if loc.count():loc.scroll_into_view_if_needed();page.screenshot(path=str(qa/(key+'-'+anchor+'.png')))
   page.locator('#wiki-body').locator('h2').last.scroll_into_view_if_needed();page.screenshot(path=str(qa/(key+'-browser-end.png')))
   reports.append(report);g.save(qa/'native-browser-verification.json',reports)
   assert data['count']==expected and data['loaded']==expected,(slug,report)
   assert not missing and report['end_marker_visible'],report
  browser.close()
 print(json.dumps(reports,indent=2),flush=True)

ORIGINAL_SOURCES=p.sources_page

def sources_with_notes(entries,media):
 ORIGINAL_SOURCES(entries,media)
 path=g.DOCS/'Weapon-Inspiration-Media-Sources.md';body=path.read_text()
 for e in entries:
  record=media[e['id']]
  if record.get('source_note'):
   note=record['source_note']
   links=' '.join('[Source naming evidence]('+u+').' for u in record.get('additional_sources',[]) if u)
   marker='<a id="ref-'+e['id']+'"></a>'
   body=body.replace(marker,marker+'\n\n'+note+' '+links+'\n')
 path.write_text(body,encoding='utf-8')
p.sources_page=sources_with_notes

def finish_known_delta():
 import collections
 from PIL import Image
 c=g.load(ROOT/'catalog.json',{});m=g.load(ROOT/'media.json',{});entries=c['gaming']+c['historical'];idx={e['id']:e for e in entries}
 assert len(c['gaming'])==892 and len(c['historical'])==152
 assert not g.load(ROOT/'specificity-report.json',{})['pending']
 assert not g.load(ROOT/'final-polish-report.json',{})['pending']
 k='1ea23263a704'
 note="Image/video reference: ZioMcCall's Flavour v22 variant."
 if note not in idx[k]['hook']:idx[k]['hook']=idx[k]['hook'].rstrip()+ ' '+note
 m[k]['image']['kind']="Named Mancubus chapter screenshot, ZioMcCall's Flavour v22 variant"
 m[k]['source_note']="The original v22 showcase labels 11:35 as Mancubus, but its chapter thumbnail still shows Revenant launchers. The displayed weapon picture and Watch link instead use the explicitly named ZioMcCall's Flavour v22 variant at 12:47; the original reference is retained here."
 m[k]['additional_sources']=list(dict.fromkeys(m[k].get('additional_sources',[])+['https://www.youtube.com/watch?v=QEZgQIDzFOo&t=695s']))
 k='d21c72146df8';url='https://www.youtube.com/watch?v=L_59BErDMTI';r=g.fetch(url)
 assert r['ok'],'Ability chapter metadata unavailable'
 data=f.parse_json_after(r['body'],[r'(?:var\s+ytInitialData|window\["ytInitialData"\]|ytInitialData)\s*=\s*'])
 chosen=None;chapters=[]
 for obj in g.walk(data):
  ch=obj.get('chapterRenderer')
  if not ch:continue
  title=g.txt(ch.get('title'));thumbs=ch.get('thumbnail',{}).get('thumbnails',[])
  chapters.append({'title':title,'time':ch.get('timeRangeStartMillis')})
  if any(a in g.norm(title) for a in ('asperg','holy water','aspersor')) and thumbs:
   chosen={'title':title,'url':thumbs[-1]['url'],'time':ch.get('timeRangeStartMillis')};break
 g.save(ROOT/'qa'/'final-ability-evidence.json',{'source':url,'chapters':chapters,'chosen':chosen})
 assert chosen,'Named holy-water chapter not located'
 im=p.image_url(idx[k],chosen['url'],m[k]['video']['url'],'Named holy-water ability chapter screenshot')
 assert im,'Named ability screenshot did not decode'
 im.update(chapter_title=chosen['title'],chapter_time=chosen['time']);m[k]['image']=im
 Image.open(ROOT/im['local']).save(ROOT/'qa'/'final-ability.png')
 d.TARGETS={};d.write_all(c,m)
 errors=[]
 for e in entries:
  rec=m[e['id']];image=rec['image'];path=ROOT/image['local']
  if hashlib.sha256(path.read_bytes()).hexdigest()!=image['sha256']:errors.append(e['id']+':image hash')
  with Image.open(path) as pic:pic.verify()
  if not rec.get('video',{}).get('url') or 'results?search' in rec['video']['url']:errors.append(e['id']+':not a direct video')
 assert not errors,errors
 g.save(ROOT/'final-acceptance.json',{'gaming_entries':len(c['gaming']),'gaming_collections':len({e['game'] for e in c['gaming']}),'historical_entries':len(c['historical']),'total_entries':len(entries),'embedded_images_with_verified_file_hashes':len(entries),'direct_video_references':len(entries),'image_specificity_pending':[],'errors':errors,'source_collection_variants_explicit':True,'video_evidence_labels':dict(collections.Counter(m[e['id']]['video']['match'] for e in entries)),'full_video_playback_reviewed':False,'live_browser_receipt':'qa/native-browser-verification.json','live_wiki_receipt':'qa/live-wiki-verification.json'})
 print('Final artifact acceptance: 1044 entries, images and direct video references; no open image-specificity repairs.',flush=True)


def main():
 if len(sys.argv)>1 and sys.argv[1]=='--native-check':native_check();return
 if len(sys.argv)==1:finish_known_delta();return
 d.main()
 if len(sys.argv)>1 and sys.argv[1]=='--verify-live':
  c=g.load(ROOT/'coverage.json',{})
  assert c['embedded_images']==c['total']==c['matched_videos']==c['complete']==1044,c
if __name__=='__main__':main()
