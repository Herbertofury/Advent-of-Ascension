  "findings": [
    {
      "reference": "Create Armorer / Crane reload_tactical",
      "observed": "Magazine has nine position keys and four rotation keys, with an initial extraction, an off-axis handoff/hold, a staged alignment and final insertion. Matching right-hand and magazine position deltas occur during the carried portion. Root/right-hand channels include Catmull-Rom keys.",
      "apply": "Author original contact-constrained hand choreography. Clear the socket before turning, align before inserting; evaluate the exact exported interpolation, including curve overshoot."
    },
    {
      "reference": "Immersive Armorer / dual_barrel_cannon",
      "observed": "Separate shoot_up/shoot_down clips animate their respective barrels plus shell, muzzle_flash, root and camera. Two reload variants have separate upper/lower magazines and hand tracks.",
      "apply": "Keep independent Baronator barrel recoil and matching flash locators. Preserve the requested top/bottom alternating successful-shot sequence; do not copy the reference ammo-threshold barrel-selection logic."
    },
    {
      "reference": "Immersive Armorer / dual_barrel_cannon_state_machine.lua",
      "observed": "Base pose, bolt state, main actions, gun kick and movement occupy separate tracks. Inspect exit restores crosshair state; shoot interrupts inspection; walking/running respond to movement state.",
      "apply": "Design layered presentation with cleanup on every exit and interruption. Validate combined poses, not only individual clips. Actual AoA/TaCZ adapter and gameplay checks remain open."
    },
    {
      "reference": "Helldivers gunpack / AC7",
      "observed": "The geometry parents the left hand and magazine/bullet assembly under one carry-space bone. Empty and tactical reloads have separate clips and multiple timed sound cues. The display has a separate LOD resource and first/third-person firing sound references.",
      "apply": "Use a shared carry-space rig to avoid hand/magazine drift, then explicitly validate ownership handoff and mechanical clearance. Keep visual clip timing distinct from authoritative feed/cooldown timing; preserve native AoA behavior."
    },
    {
      "reference": "Ars Armorer / source-ejector",
      "observed": "The inspected pistol animation file has no conventional reload clips. Its firing animates the core and upper/lower barrel groups. The inspected normal_ars_logic script uses attachment-dependent resource-named parameters and TaCZ ammo-count methods.",
      "apply": "Design coherent resource/charge presentation instead of imposing a magazine reload on every AoA weapon. Mana-named parameters do not prove integration with actual Ars Source or AoA Spirit."
    }
  ]
}
